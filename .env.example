APP_NAME=PerfumeHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default local setup: PostgreSQL 18 on Windows.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=perfumehub_backend
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Used by config/cors.php for Expo Web and local browser development.
# Native Android/iOS requests are not governed by browser CORS, but the API
# still needs to accept the web development origins below.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:8081

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@perfumehub.test"
MAIL_FROM_NAME="${APP_NAME}"
# Optional regex permitting local/private-network Expo Web origins.
CORS_ALLOWED_ORIGIN_PATTERN='#^http://(localhost|127\.0\.0\.1|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|192\.168\.[0-9]{1,3}\.[0-9]{1,3})(:[0-9]+)?$#'
